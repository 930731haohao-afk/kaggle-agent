#!/usr/bin/env bash
# Pre-commit gate: check-only lint + test suite.
#
# Design constraints (see docs discussion 2026-07-31):
#   - CHECK ONLY, never --fix: the committed script must be byte-identical to
#     the script that ran, or experiment provenance breaks.
#   - ruff version PINNED: unpinned lint results drift as ruff releases.
#   - competitions/ is excluded via pyproject.toml [tool.ruff] — frozen as-run
#     record of past experiments, never linted.
#   - Bypassing with --no-verify is possible but must be noted in the commit
#     message; a silently bypassed gate is worse than no gate.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# The login shell auto-activates ~/pytorch/.venv; neutralize so uv/uvx resolve
# this project's environment instead.
export VIRTUAL_ENV=""

echo "[pre-commit] ruff 0.16.1 (check-only)"
if ! uvx ruff@0.16.1 check .; then
    echo "[pre-commit] BLOCKED: lint failures above. No auto-fix by design."
    exit 1
fi

echo "[pre-commit] pytest tests/"
if ! uv run pytest tests/ -q; then
    echo "[pre-commit] BLOCKED: test failures above."
    exit 1
fi

echo "[pre-commit] OK"
