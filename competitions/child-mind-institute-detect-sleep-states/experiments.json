{
  "competition": "child-mind-institute-detect-sleep-states",
  "experiments": [
    {
      "id": 1,
      "name": "LightGBM Baseline (1-min downsample)",
      "model": "lightgbm",
      "params": {
        "objective": "binary",
        "metric": "binary_logloss",
        "learning_rate": 0.05,
        "num_leaves": 63,
        "max_depth": -1,
        "min_child_samples": 100,
        "feature_fraction": 0.8,
        "bagging_fraction": 0.8,
        "bagging_freq": 1,
        "scale_pos_weight": 100,
        "verbose": -1,
        "n_jobs": -1,
        "seed": 42
      },
      "n_features": 27,
      "downsample": 12,
      "notes": "1-minute downsampled, rolling 15/30/60min features, peak detection, GroupKFold by series_id"
    }
  ]
}