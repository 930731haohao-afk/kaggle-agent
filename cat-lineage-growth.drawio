<mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1040" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="CAT lineage growth: queue phase then fallback phase (s3e9, RMSE, lower is better)" style="text;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="800" height="44" as="geometry"/>
    </mxCell>

    <mxCell id="legend" value="Legend&#10;&#10;✓ = became new global best&#10;✗ = did not improve&#10;[x] = the change applied to the parent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="40" y="110" width="220" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="root" value="root&#10;(reference LGB, 12.11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="310" y="100" width="200" height="44" as="geometry"/>
    </mxCell>

    <mxCell id="cat" value="CAT seed / head&#10;CatBoost depth6, l2=6&#10;RMSE 12.075" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="184" width="240" height="66" as="geometry"/>
    </mxCell>

    <mxCell id="c1" value="c1   [l2=9]&#10;12.062   ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="290" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c2" value="c2   [+depth=5]&#10;12.058   ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="390" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c3" value="c3   [+bag_temp]&#10;12.060   ✗   (sibling dead-end)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="500" width="220" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c4" value="c4   [+lr=0.015]&#10;12.055   ✓   best of lineage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="290" y="500" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c5" value="c5   [+rand_str]&#10;12.056   ✗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="610" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c6" value="c6   [seed=1000]&#10;12.054   ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="720" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c7" value="c7   [seed=1001]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="820" width="240" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="c8" value="c8   [seed=1002]   →   ... until plateau / node budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="920" width="300" height="64" as="geometry"/>
    </mxCell>

    <mxCell id="qnote" value="QUEUE phase&#10;&#10;idx = 0 .. 4&#10;CAT_QUEUE[idx] applied to parent&#10;5 authored mutations:&#10;l2, depth, bag_temp, lr, rand_str&#10;&#10;child = parent + one change&#10;(accumulates down the winning chain)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eaf2ff;strokeColor=#6c8ebf;fontSize=11;dashed=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="290" width="240" height="374" as="geometry"/>
    </mxCell>

    <mxCell id="fnote" value="FALLBACK phase&#10;&#10;idx ≥ 5  (queue exhausted)&#10;fallback_mutation:&#10;same config, new random seed&#10;seed = 1000 + (idx − 5)&#10;→ 1000, 1001, 1002, ...&#10;&#10;unbounded supply of new nodes&#10;so the lineage can EXCEED&#10;the queue length&#10;(stops only on plateau / budget)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff0e0;strokeColor=#d79b00;fontSize=11;dashed=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="720" width="240" height="264" as="geometry"/>
    </mxCell>

