<mxfile host="drawio_gen.py">
  <diagram id="d0" name="Tree Search Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Kaggle-Agent 樹搜尋架構(harness v1→v3;確定性、GBDT 組態空間)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell>
        <mxCell id="seed" value="driver 手動種下第一代世系
(root 的數個子節點 = 不同起始方向)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470.0" y="88" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="phase" value="相位機 update_phase
exploit → explore_burst → stopped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470.0" y="170" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="stop" value="should_stop ?  預算 60 節點 / burst 後無改善" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470.0" y="252" width="300" height="72" as="geometry" /></mxCell>
        <mxCell id="select" value="select_next_parent
active 世系中分數最佳、仍有展開額度
(全 plateaued 時自動 reopen 次佳世系)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470.0" y="356" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="propose" value="提出變異 propose_child
種子 / boundary-push / 重組" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470.0" y="452" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="dedup" value="config_hash 去重 ?  同父連兩次重複 → 燒 failed 佔位" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470.0" y="536" width="300" height="72" as="geometry" /></mxCell>
        <mxCell id="eval" value="評分 evaluate(config)
solo:K-fold → OOF 快取  |  blend:OOF 權重搜尋(Dirichlet k=800+座標上升)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="640" width="500" height="56" as="geometry" /></mxCell>
        <mxCell id="add" value="add_node → 比對全域最佳
贏:streak=0   |   沒贏:streak+1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470.0" y="728" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="plateau" value="streak ≥ 門檻(3;離散指標 5)?
是 → 世系 plateaued(下輪 select 改選次佳)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470.0" y="812" width="300" height="72" as="geometry" /></mxCell>
        <mxCell id="done" value="輸出全域最佳解
→ OOF 逐位重現閘門 → 產生 submission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="88" width="260" height="72" as="geometry" /></mxCell>
        <mxCell id="burst" value="全部 plateaued → 強制 explore_burst
注入 5–8 條長射程新世系
+ burst 種子健全閘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="980" y="240" width="260" height="104" as="geometry" /></mxCell>
        <mxCell id="layers" value="分層來源(harness 疊加式,舊層原封不動供重現):
• v1 harness.py:節點/樹結構、select_next_parent 選點、plateau 連續不進步回溯
• v2:solo/blend kind、OOF 快取、eval_blend 權重搜尋、child dedup、metric-aware plateau、suggest_priors
• v3:預算相位機、dedup 燒預算、boundary-push、座標上升精修、成本護欄、子行程硬逾時、burst 健全閘、resume 契約
• v4:外部想法注入 hook（J-3 發現:tree[&#x27;priors&#x27;] write-only = 對搜尋 no-op）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="1180" height="140" as="geometry" /></mxCell>
