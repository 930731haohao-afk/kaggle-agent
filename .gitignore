# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Competition data (large files)
competitions/*/data/
competitions_vision/*/data/

# CatBoost training artifacts
catboost_info/

# Cached OOF/pred arrays for iteration rounds (regenerable, large)
competitions/*/scripts/cache/
competitions_vision/*/scripts/cache/

# Tree-search solo-node OOF/pred caches (regenerable via tree_search/run_*.py, kept out
# of git -- experiments_tree.json itself is small and stays tracked)
tree_search/cache_*/

# Credentials / secrets
.env
kaggle.json

# 打包產物(skill zip 匯出檔,由源檔重新產生)
*.skill
mlruns/
mlflow.db
